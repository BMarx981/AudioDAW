{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: macOS",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "deviceId": "macos"
    },
    {
      "name": "Flutter: Windows",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "deviceId": "windows"
    },
    {
      "name": "Flutter: Linux",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "deviceId": "linux"
    },
    {
      "name": "Rust: Debug tests (engine)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["test", "--no-run", "--workspace"],
        "filter": { "kind": "lib" }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ]
}
